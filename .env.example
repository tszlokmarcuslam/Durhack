# Copy to .env and fill in. Never commit .env.

# ---- Public (shipped to the browser) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server only (never prefix with VITE_) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# "true" lets the companion endpoint run without Supabase/Gemini for UI work.
# Replies are then clearly labelled as local dev mode. Never set in production:
# without Supabase it disables authentication.
ECHO_DEV_MODE=false
